# Zmienne środowiskowe TWINEMA. Pełna lista z typami i walidacją: web/twinema/config.py
# Lokalnie wystarczy DJANGO_DEBUG=true i DJANGO_ALLOWED_HOSTS='*' — reszta ma bezpieczne wartości domyślne.

# ── Django (wymagane na produkcji) ─────────────────────────────────────────
DJANGO_SECRET_KEY=YOUR_KEY_HERE
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# ── Baza i pliki ────────────────────────────────────────────────────────────
# Puste DATABASE_URL = SQLite (plik w DB_PATH albo web/db.sqlite3)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/twinema
DB_PATH=
MEDIA_ROOT=/app/web/media

# ── Publiczne demo (manage.py seed_demo) ────────────────────────────────────
# DEMO_SEED=true odpala seed_demo przy każdym starcie kontenera (idempotentnie)
DEMO_SEED=false
# DEMO_PUBLIC=true: wejście bez logowania przez /demo/ (konto `demo` w roli Podgląd, tylko odczyt)
DEMO_PUBLIC=false
# Hasło konta `demo`, min. 8 znaków; puste = konto bez hasła przy DEMO_PUBLIC, inaczej nie powstaje
DEMO_PASSWORD=YOUR_DEMO_PASSWORD_HERE
# Adres filmu (https://…, np. YouTube) — przycisk „Zobacz film” na /demo/
DEMO_VIDEO_URL=
# Konto administratora tworzone przy pierwszym starcie kontenera (opcjonalnie)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ── Render (opcjonalnie) ────────────────────────────────────────────────────
# Min. 32 znaki; ten sam w workerze na PC z Blenderem (tools/render_worker.py). Puste = API workera wyłączone
RENDER_WORKER_TOKEN=YOUR_KEY_HERE

# ── Studio: film i deck (opcjonalnie) ───────────────────────────────────────
# Puste = szkic z Claude wyłączony
ANTHROPIC_API_KEY=YOUR_KEY_HERE
# Puste = lektor wyłączony
ELEVENLABS_API_KEY=YOUR_KEY_HERE
ELEVENLABS_VOICE_ID=YOUR_VOICE_ID_HERE

# ── Obserwowalność (opcjonalnie) ────────────────────────────────────────────
SENTRY_DSN=
CSP_REPORT_ONLY=true
