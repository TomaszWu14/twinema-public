# Zmienne krytyczne dla wdrożenia (pełna lista z typami: web/twinema/config.py)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=twinema.twapp.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://twinema.twapp.pl
